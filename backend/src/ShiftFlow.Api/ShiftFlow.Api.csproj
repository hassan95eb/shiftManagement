<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Common build settings: see backend/Directory.Build.props and
       backend/src/Directory.Build.props. -->

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />

    <!-- Swagger UI with a working Authorize button. Swashbuckle 10.x depends on
         Microsoft.OpenApi 2.7.5, which carries the fix for GHSA-v5pm-xwqc-g5wc
         (NU1903) — the reason the template's Microsoft.AspNetCore.OpenApi
         reference (transitive Microsoft.OpenApi 2.0.0) was dropped here. -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />

    <!-- Design-time only: this is the EF Core startup project, so `dotnet ef`
         loads its migration tooling from here. Not shipped at runtime. The
         migrations themselves live in ShiftFlow.Infrastructure. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShiftFlow.Application\ShiftFlow.Application.csproj" />
    <ProjectReference Include="..\ShiftFlow.Infrastructure\ShiftFlow.Infrastructure.csproj" />
  </ItemGroup>

</Project>
