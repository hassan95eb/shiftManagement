<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework / Nullable / ImplicitUsings come from
       backend/Directory.Build.props. TreatWarningsAsErrors is deliberately
       NOT inherited here (test project). -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />

    <!-- Relational SQLite for the use-case tests: unlike EF Core InMemory it
         honours unique and CHECK constraints, which several of these tests are
         specifically about (CLAUDE.md §8). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />

    <!-- Decode issued JWTs in the token tests. Version tracks the transitive
         Microsoft.IdentityModel.* that Api's JwtBearer 10.0.11 resolves. -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.2" />
  </ItemGroup>

  <!-- DefaultHttpContext for the error-middleware tests. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ShiftFlow.Domain\ShiftFlow.Domain.csproj" />
    <ProjectReference Include="..\..\src\ShiftFlow.Application\ShiftFlow.Application.csproj" />
    <ProjectReference Include="..\..\src\ShiftFlow.Infrastructure\ShiftFlow.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\ShiftFlow.Api\ShiftFlow.Api.csproj" />
  </ItemGroup>

</Project>
