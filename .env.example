# ---------------------------------------------------------------------------
# ShiftFlow — environment variable map
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored;
# only this example is committed (docs/02-repository-structure.md §7).
# ---------------------------------------------------------------------------

# --- SQL Server (docker-compose `db` service) ------------------------------
# The SA password MUST be strong: upper + lower + digit + symbol, 8+ chars.
# A weak password makes the SQL Server 2022 container exit silently
# (CLAUDE.md §11 / docs/02 §6).
MSSQL_SA_PASSWORD=Your_Strong_Passw0rd!
MSSQL_DB=ShiftFlow
# Host port mapped to the container's 1433. Change if 1433 is taken locally.
MSSQL_PORT=1433

# --- API ----------------------------------------------------------------------
# The API reads these from the environment; appsettings.json holds only the
# non-secret defaults (Jwt issuer/audience/lifetime) and empty placeholders.
ConnectionStrings__Default=Server=localhost,1433;Database=ShiftFlow;User Id=sa;Password=Your_Strong_Passw0rd!;TrustServerCertificate=True

# JWT signing key — a real secret, never committed. Minimum 32 bytes; generate
# with `openssl rand -base64 48`. Issuer/Audience/lifetime only need setting here
# to override the appsettings.json defaults. No refresh token (CLAUDE.md §3).
Jwt__Key=replace-with-a-random-secret-of-at-least-32-bytes
# Jwt__Issuer=shiftflow
# Jwt__Audience=shiftflow
# Jwt__AccessTokenLifetimeMinutes=60

# On startup, apply pending migrations and insert the scenario seed (two
# employers, seven experts, projects/shifts/applications arranged so each apply
# rule can be seen to pass and fail — see README.md). Always on in the
# Development environment; set this to true to also get it in other environments.
# Leave false / unset in production, which migrates as a separate deploy step.
# AutoMigrate=false

# ---------------------------------------------------------------------------
# Scoring — read by the Python recommender (python/config.py). ASP.NET binds
# the same names (Scoring:RatingWeight ← SCORING__RATINGWEIGHT), so one .env
# feeds both sides and the two implementations cannot diverge (docs/02 §5).
# The API has no ScoringOptions binding yet; until it does these are read on
# the Python side only. The values below are the CLAUDE.md §5 defaults —
# config.py falls back to them when a variable is unset.
# ---------------------------------------------------------------------------
SCORING__RATINGWEIGHT=0.30
SCORING__WORKLOADWEIGHT=0.30
SCORING__AVAILABILITYWEIGHT=0.40
SCORING__MONTHLYCAP=160
# Score for an expert with no rating row.
SCORING__RATINGDEFAULT=3.0
